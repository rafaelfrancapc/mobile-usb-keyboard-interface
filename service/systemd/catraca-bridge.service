[Unit]
Description=Catraca — ponte ADB (rede) entre o tablet e o teclado virtual da Pi
Documentation=https://github.com/rafaelfrancapc/mobile-usb-keyboard-interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/catraca-bridge.conf
ExecStart=/usr/local/bin/catraca-bridge

# Reconecta sozinho se o tablet cair, reiniciar, trocar de IP etc.
Restart=always
RestartSec=3

# Roda sem privilégio de root: precisa apenas de acesso a /dev/uinput,
# concedido via grupo "input" pela regra de udev (99-catraca-uinput.rules).
# Ver README para criar o usuário "catraca" e adicioná-lo ao grupo.
User=catraca
Group=catraca
SupplementaryGroups=input

# Superfície de ataque reduzida — mas SEM ProtectHome: o "adb" que este
# serviço invoca guarda sua chave RSA de pareamento em ~/.android/ do
# usuário "catraca", e ela precisa persistir entre reinícios do serviço
# (senão o tablet pediria autorização de depuração USB de novo a cada
# restart). Dê um HOME de verdade (gravável) pro usuário "catraca" — ver
# README.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
