[Unit]
Description=Catraca — ponte ADB (rede) com digitação via pyautogui
# Precisa da sessão gráfica já ativa (pyautogui não roda headless) — por
# isso PartOf/After em graphical-session.target, e por isso este é um
# serviço de USUÁRIO (systemctl --user), não um serviço de sistema.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/catraca-bridge.conf

# Ajuste se o seu setup usar outro display/monitor — pra confirmar o valor
# certo, abra um terminal DENTRO da sessão gráfica da Pi e rode `echo $DISPLAY`.
Environment=DISPLAY=:0

ExecStart=/usr/bin/python3 %h/catraca-bridge/catraca_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
