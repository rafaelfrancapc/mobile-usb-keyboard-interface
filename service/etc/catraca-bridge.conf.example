# ~/.config/catraca-bridge.conf
#
# IP do TABLET na rede privada entre ele e a Pi. É pra este IP que a Pi vai
# rodar `adb connect`. Confirme no menu oculto de rede do app (segure o
# rótulo "IDENTIFICAÇÃO DIGITADA" na tela do tablet).
#
# TROQUE ISSO — não deixe o valor de exemplo abaixo:
CATRACA_TABLET_IP=192.168.42.129

# Porta do adbd no tablet (precisa estar em `adb tcpip 5555`).
CATRACA_ADB_PORT=5555

# Porta que o app abre no tablet e que a Pi encaminha via `adb forward`.
CATRACA_APP_PORT=8765

# pyautogui = digita de verdade na janela em foco (produção).
# log       = só imprime o que digitaria, sem tocar em pyautogui (teste,
#             funciona até sem sessão gráfica).
CATRACA_INPUT_MODE=pyautogui
